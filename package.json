    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "operations:migrate": "prisma migrate deploy",
    "operations:baseline:existing": "prisma migrate resolve --applied 20261104000000_legacy_portfolio_baseline",
    "operations:seed": "node --env-file=.env prisma/seed-operations.mjs",
    "operations:seed:local": "node prisma/seed-operations.mjs",
    "test:operations": "node --experimental-strip-types --test tests/operations/*.test.mjs",
    "prisma:seed": "node prisma/seed.mjs",
